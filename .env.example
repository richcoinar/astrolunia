# Proyecto Supabase confirmado por el propietario de Astrolunia PWA.
# URL publica; esta variable no es un secreto.
NEXT_PUBLIC_SUPABASE_URL=https://bdhwkvlpnixfamsvjfco.supabase.co

# Copiar la clave publishable (sb_publishable_...) desde Supabase → Project Settings → API Keys.
# No usar secret, service_role ni JWT secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mantener false hasta disponer de política de privacidad, términos y borrado de cuenta probado.
NEXT_PUBLIC_ENABLE_REGISTRATION=false

# Solo se habilita la IA tras probar RLS, cuota y presupuestos en Supabase.
ASTROLUNIA_AI_ENABLED=false
# Secreto solo del servidor: nunca usar NEXT_PUBLIC_ para la API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_SITE_ORIGIN=https://astrolunia.publicalogratis.store
